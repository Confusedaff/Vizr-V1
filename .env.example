# Copy this to .env before running `docker compose up`.

# REQUIRED: generate with `openssl rand -hex 32` — used to sign JWTs.
# There is no default; docker-compose will refuse to start without it.
JWT_SECRET_KEY=

# --- LLM provider (for local development) -----------------------------
#
# The intended usage pattern is per-request keys pasted into the frontend
# (nothing here is required for that to work). These are only for an
# operator-configured *fallback* used when a request doesn't supply its
# own key — handy while developing so you don't have to paste a key into
# the UI every time you restart the stack.
#
# LLM_PROVIDER picks which of the three below is used by default:
# "groq" (default), "gemini", or "anthropic".
LLM_PROVIDER=groq

# Groq — https://console.groq.com/keys (free, no credit card, fastest to
# set up: sign up with Google/GitHub, click "Create API Key", done).
GROQ_API_KEY=

# Gemini — https://aistudio.google.com/apikey (free tier, needs a Google
# account; a couple more clicks than Groq but no credit card either).
GEMINI_API_KEY=

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
# (paid, no free tier, kept as an option for anyone who already has one).
ANTHROPIC_API_KEY=

# MinIO / S3-compatible object storage credentials. Defaults below match
# docker-compose.yml's minio service — override only if you point
# S3_ENDPOINT_URL at a different (e.g. real AWS) endpoint.
S3_ACCESS_KEY=vizr_minio_admin
S3_SECRET_KEY=vizr_minio_secret
S3_BUCKET=vizr-videos
# Host used when signing presigned video URLs returned to the browser.
# Leave as localhost:9000 for local docker-compose use. If you deploy
# behind a domain/reverse proxy in front of MinIO, set this to that
# public URL instead (e.g. https://videos.example.com).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# "docker" (default) sandboxes each render in an isolated container with
# no network access, read-only root, non-root user, and capped
# CPU/memory. "subprocess" skips the sandbox entirely — faster to start
# (no image build step) but weaker isolation; useful for local dev
# without Docker-outside-of-Docker set up.
SANDBOX_MODE=docker

# Base URL the built frontend calls for the API — must be reachable from
# the *browser*, not just from other containers, so localhost:8000 (not
# http://api:8000) is correct for a typical local docker compose setup.
VITE_API_BASE_URL=http://localhost:8000
