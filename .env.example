# Copy this to .env before running `docker compose up`.

# REQUIRED: generate with `openssl rand -hex 32` — used to sign JWTs.
# There is no default; docker-compose will refuse to start without it.
JWT_SECRET_KEY=

# Optional: operator-configured fallback Anthropic API key. If unset,
# every request must supply its own key (api_key field), which is the
# intended default usage pattern for this project.
ANTHROPIC_API_KEY=

# MinIO / S3-compatible object storage credentials. Defaults below match
# docker-compose.yml's minio service — override only if you point
# S3_ENDPOINT_URL at a different (e.g. real AWS) endpoint.
S3_ACCESS_KEY=aiviz_minio_admin
S3_SECRET_KEY=aiviz_minio_secret
S3_BUCKET=aiviz-videos

# "docker" (default) sandboxes each render in an isolated container with
# no network access, read-only root, non-root user, and capped
# CPU/memory. "subprocess" skips the sandbox entirely — faster to start
# (no image build step) but weaker isolation; useful for local dev
# without Docker-outside-of-Docker set up.
SANDBOX_MODE=docker

# Base URL the built frontend calls for the API — must be reachable from
# the *browser*, not just from other containers, so localhost:8000 (not
# http://api:8000) is correct for a typical local docker compose setup.
VITE_API_BASE_URL=http://localhost:8000
