# Multi-stage build: compile the Vite app, then serve the static bundle
# with a minimal nginx. The API base URL is baked in at build time via
# VITE_API_BASE_URL (docker-compose passes it through) since Vite embeds
# env vars into the built JS bundle, not read at container runtime.
FROM node:22-slim AS build

WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json* ./
RUN npm install

COPY apps/web/ ./
ARG VITE_API_BASE_URL=http://localhost:8000
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# SPA fallback: any path not matching a static file serves index.html so
# React Router's client-side routes (e.g. /jobs/abc123) work on a hard
# refresh, not just via in-app navigation.
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    location / {\n\
        try_files $uri /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
